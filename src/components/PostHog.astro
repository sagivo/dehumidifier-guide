---
// PostHog analytics: visitors ($pageview/$pageleave), link clicks
// (autocapture + custom `affiliate_click`), and performance ($web_vitals).
//
// Config via build-time env:
//   PUBLIC_POSTHOG_KEY  – PostHog project API key (required, else renders nothing)
//   PUBLIC_POSTHOG_HOST – e.g. https://us.i.posthog.com (default) or https://eu.i.posthog.com
//
// Web Vitals ($web_vitals) must also be enabled once in PostHog:
// Project settings → Autocapture & heatmaps → Web vitals autocapture → Enable.
const key = (import.meta.env.PUBLIC_POSTHOG_KEY as string | undefined)?.trim();
const host = (
  (import.meta.env.PUBLIC_POSTHOG_HOST as string | undefined)?.trim() || "https://us.i.posthog.com"
).replace(/\/$/, "");
---

{
  key ? (
    <script is:inline define:vars={{ key, host }}>
      !(function (t, e) {
        var o, n, p, r;
        e.__SV ||
          ((window.posthog = e),
          (e._i = []),
          (e.init = function (i, s, a) {
            function g(t, e) {
              var o = e.split(".");
              2 == o.length && ((t = t[o[0]]), (e = o[1])),
                (t[e] = function () {
                  t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
                });
            }
            ((p = t.createElement("script")).type = "text/javascript"),
              (p.crossOrigin = "anonymous"),
              (p.async = !0),
              (p.src = s.api_host + "/static/array.js"),
              (r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(p, r);
            var u = e;
            for (
              void 0 !== a ? (u = e[a] = []) : (a = "posthog"),
                u.people = u.people || [],
                u.toString = function (t) {
                  var e = "posthog";
                  return "posthog" !== a && (e += "." + a), t || (e += " (stub)"), e;
                },
                u.people.toString = function () {
                  return u.toString(1) + ".people (stub)";
                },
                o =
                  "init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey canRenderSurveyAsync identify setPersonProperties setPersonPropertiesForFlags resetGroups setGroupPropertiesForFlags setGroupProperties resetGroup addGroup removeGroup trackEventPosition getProperty setProperty trackPageView trackPageLeave optOutCapturing hasOptedOutCapturing clearOptOutCapturing optInCapturing reset doNotTrack debug disableSrvVar getDistinctId alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureExceptions loadToolbar getToolbarParams exceptionsLoaded startExceptionAutocapture loadScript".split(
                    " ",
                  ),
                n = 0;
              n < o.length;
              n++
            )
              g(u, o[n]);
            e._i.push([i, s, a]);
          }),
          (e.__SV = 1));
      })(document, window.posthog || []);

      window.posthog.init(key, {
        api_host: host,
        defaults: "2026-05-30",
        // Visitors
        capture_pageview: true,
        capture_pageleave: true,
        // Links: autocapture clicks on <a>/<button>; affiliate handler below adds context.
        autocapture: true,
        // Performance: navigation timing + $web_vitals (enable in project settings).
        capture_performance: true,
        // Privacy-friendly defaults: no replays, respect DNT.
        disable_session_recording: true,
        respect_dnt: true,
        person_profiles: "identified_only",
      });

      // Rich affiliate-link tracking on top of autocapture.
      // Fires `affiliate_click` for Amazon / .aff links and BuyButtons (data-model),
      // `outbound_click` for other external links.
      document.addEventListener(
        "click",
        function (e) {
          try {
            var el = e.target && e.target.closest ? e.target.closest("a[href]") : null;
            if (!el) return;
            var href = el.getAttribute("href") || "";
            if (!href || href.charAt(0) === "#" || href.indexOf("javascript:") === 0) return;
            var isAff =
              el.classList.contains("aff") ||
              el.hasAttribute("data-model") ||
              /^https?:\/\/(www\.)?amazon\.com\//i.test(href);
            var isOutbound = false;
            try {
              isOutbound = new URL(href, location.href).origin !== location.origin;
            } catch (err) {
              return;
            }
            if (!isAff && !isOutbound) return;
            var props = {
              destination: href,
              link_text: (el.textContent || "").trim().slice(0, 120),
              page: location.pathname,
              is_affiliate: isAff,
            };
            if (el.hasAttribute("data-model")) props.model = el.getAttribute("data-model");
            window.posthog.capture(isAff ? "affiliate_click" : "outbound_click", props);
          } catch (err) {
            /* never break navigation */
          }
        },
        true,
      );
    </script>
  ) : (
    <!-- No PUBLIC_POSTHOG_KEY set: analytics disabled -->
  )
}
